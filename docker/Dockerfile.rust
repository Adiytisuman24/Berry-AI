FROM rust:1.80-alpine AS builder
RUN apk add --no-cache musl-dev
WORKDIR /app
COPY services/rust-ledger/Cargo.toml services/rust-ledger/Cargo.lock ./
COPY services/rust-ledger/src ./src
RUN cargo build --release

FROM alpine:3.19
WORKDIR /app
COPY --from=builder /app/target/release/rust-ledger /app/rust-ledger
EXPOSE 8081
ENTRYPOINT ["/app/rust-ledger"]
