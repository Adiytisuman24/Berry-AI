# 🍇 BERRY AI — Environment Configuration Template
# Copy this file to .env and insert your real credentials.

# Razorpay API Credentials
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

# OpenAI Vision & NLP API
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_API_KEY"

# Database & Cache Backends
DATABASE_URL="postgres://apple@localhost:5432/berry_db?sslmode=disable"
REDIS_URL="localhost:6379"

# Microservice Ports
PORT="8080"
NEXT_PUBLIC_API_URL="http://localhost:8080"
RUST_LEDGER_URL="http://127.0.0.1:8081"
PY_AGENT_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_AGENT_URL="http://localhost:8000"
